# Server
PORT=8080
NODE_ENV=production
CORS_ORIGIN=http://localhost:5010,http://localhost:5173,http://localhost:8080,http://127.0.0.1:5010,*
LOG_ANALYTICS_WORKSPACE_ID=11111111-1111-1111-1111-111111111111
ALLOW_WORKSPACE_OVERRIDE=true
QUERY_TIMEOUT_MS=30000
QUERY_MAX_ROWS=50000
QUERY_MAX_LENGTH=20000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ==============================================================================
# PREDEFINED LOG ANALYTICS WORKSPACES (MULTI-SUBSCRIPTION SUPPORT)
# ==============================================================================
# Define Log Analytics workspaces organized by Azure Subscription for the UI dropdown selector.
# Format: SubscriptionName/WorkspaceName:WorkspaceCustomerId (comma-separated)
#
# Syntax breakdown:
#   <SubscriptionName>/<WorkspaceName>:<WorkspaceCustomerId-GUID>
#
# Examples:
#   1. Add a single workspace under a subscription:
#      Production/App-Logs:11111111-1111-1111-1111-111111111111
#
#   2. Add multiple workspaces under the SAME subscription:
#      Production/EastUS-Logs:11111111-1111-1111-1111-111111111111,Production/WestEurope-Logs:22222222-2222-2222-2222-222222222222
#
#   3. Add a NEW subscription with its own workspace:
#      Staging/Staging-Logs:33333333-3333-3333-3333-333333333333,Security/Sentinel-Workspace:44444444-4444-4444-4444-444444444444
#
# Supported Delimiters:
#   - Slash format (Recommended): "Subscription/WorkspaceName:WorkspaceId"
#   - Colon format:               "Subscription:WorkspaceName:WorkspaceId"
#   - Legacy format:              "WorkspaceName:WorkspaceId" (assigned to "Default Subscription")
# ==============================================================================
VITE_WORKSPACES=Production/EastUS-Logs:11111111-1111-1111-1111-111111111111,Production/WestEurope-Logs:22222222-2222-2222-2222-222222222222,Staging/Staging-Logs:33333333-3333-3333-3333-333333333333,Security/Sentinel-Logs:44444444-4444-4444-4444-444444444444


# Require Azure AD MSAL Authentication (set to false to bypass login screen & use .env workspace IDs directly)
VITE_REQUIRE_AZURE_AD_AUTH=false

# Azure AD MSAL Authentication Redirect URIs (Register these in Azure Portal -> App Registrations -> Single-page application)
VITE_AZURE_REDIRECT_URI=/auth/callback
VITE_AZURE_LOGIN_URI=/auth/login

# Restrict Azure AD Login to specific AD Security Groups (comma-separated Group Object IDs or names). Leave empty to allow all AD users.
VITE_ALLOWED_AZURE_AD_GROUPS=

# Azure Identity - choose one supported path.
# Preferred in Azure-hosted containers: Managed Identity. Set AZURE_CLIENT_ID only
# when using a user-assigned managed identity.
# AZURE_CLIENT_ID=

# Service principal with secret (uncomment and populate if using SPN with secret).
# AZURE_TENANT_ID=22222222-2222-2222-2222-222222222222
# AZURE_CLIENT_ID=33333333-3333-3333-3333-333333333333
# AZURE_CLIENT_SECRET=YOUR_AZURE_CLIENT_SECRET_VALUE

# Service principal with certificate.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_CERTIFICATE_PATH=/run/secrets/spn-cert.pem
# AZURE_CLIENT_CERTIFICATE_PASSWORD=
# AZURE_CLIENT_SEND_CERTIFICATE_CHAIN=true

# Sovereign cloud, optional.
# AZURE_AUTHORITY_HOST=
